# Port server lokal. Vercel mengabaikan ini.
PORT=3000

# ---------- Keamanan akses ----------
# Kunci API. Boleh lebih dari satu, pisahkan dengan koma (untuk rotasi).
# Kosongkan hanya untuk pengembangan lokal. Di Vercel WAJIB diisi.
# Buat kunci acak: openssl rand -hex 32
API_KEYS=

# Paksa API key walau API_KEYS kosong (semua request akan ditolak).
REQUIRE_API_KEY=0

# Origin frontend yang boleh memakai API dari browser.
# Pisahkan dengan koma. Dukung wildcard, mis. https://proyek-*.vercel.app
# Kosongkan untuk mengizinkan semua origin (tidak disarankan untuk publik).
ALLOWED_ORIGINS=

# Secret untuk menandatangani URL /api/image. Kalau kosong, memakai API_KEYS pertama.
# Sebaiknya diisi terpisah: openssl rand -hex 32
IMAGE_SIGNING_SECRET=

# Umur URL gambar bertanda tangan (detik). Default 24 jam.
IMAGE_URL_TTL_SECONDS=86400

# Batas request per menit per IP (per instance).
RATE_LIMIT=120

# Cache HTML/JSON untuk plugin komik (detik).
CACHE_TTL_SECONDS=300

# Plugin komik eksperimental.
ENABLE_EXPERIMENTAL=1

# FlareSolverr hanya dipakai plugin komik yang kena Cloudflare.
# Kosongkan kalau tidak memakai Docker/FlareSolverr.
FLARESOLVERR_URL=
FLARESOLVERR_TIMEOUT_MS=120000

# Fallback curl untuk komik. Set 0 kalau runtime tidak punya curl.
CURL_FALLBACK=1

# Batas ukuran gambar yang diproksi /api/image (byte) dan batas waktu total (ms).
MAX_IMAGE_BYTES=10485760
IMAGE_TIMEOUT_MS=30000

# ---------- Novel: Sakuranovel ----------
SAKURANOVEL_BASE_URL=https://sakuranovel.id
SAKURANOVEL_CACHE_TTL_SECONDS=300
SAKURANOVEL_CACHE_MAX_ENTRIES=500
SAKURANOVEL_TIMEOUT_MS=12000
SAKURANOVEL_USER_AGENT=KomikNovelAPI/2.1 (metadata-only; creator: Panz-08)
